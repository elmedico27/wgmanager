HERE = os.path.dirname(os.path.realpath(__file__))

ACCOUNT = "wgweb"
HELPER_PATH = "/usr/local/sbin/wgmanager-helper"
HELPER_DIR = "/usr/local/sbin"
SUDOERS_PATH = "/etc/sudoers.d/wgmanager"
SSHD_DROPIN_PATH = "/etc/ssh/sshd_config.d/wgmanager.conf"
CONFIG_DIR = "/etc/wgmanager"
AUTHORIZED_KEYS_PATH = "/etc/wgmanager/authorized_keys"

FORCED_COMMAND = "sudo -n /usr/local/sbin/wgmanager-helper --ssh"
SUDO_RULE = "(root) NOPASSWD: /usr/local/sbin/wgmanager-helper --ssh"

# Groups that would give the service account power it must not have.
PRIVILEGED_GROUPS = {"sudo", "wheel", "admin", "root", "docker", "lxd", "adm",
                     "disk", "shadow", "staff"}

# What sshd must report for the service account. sshd takes the FIRST value it
# finds for a keyword, so an earlier file can silently override our drop-in.
SSHD_EXPECT = (
    ("forcecommand", FORCED_COMMAND),
    ("authorizedkeysfile", AUTHORIZED_KEYS_PATH),
    ("pubkeyauthentication", "yes"),
    ("passwordauthentication", "no"),
    ("kbdinteractiveauthentication", "no"),
    ("authenticationmethods", "publickey"),
    ("permittty", "no"),
    ("x11forwarding", "no"),
    ("allowagentforwarding", "no"),
    ("allowtcpforwarding", "no"),
    ("permittunnel", "no"),
    ("disableforwarding", "yes"),
)
SSHD_KEY_NAMES = {"allowusers": "AllowUsers", "allowgroups": "AllowGroups"}
BOOLEAN_WORDS = {"true": "yes", "false": "no"}     # sshd -T prints some booleans this way
SSHD_ALIASES = {"kbdinteractiveauthentication": ("challengeresponseauthentication",)}

SSHD_PROBE = "user=%s,host=localhost,addr=127.0.0.1" % ACCOUNT

KEY_TYPES_RE = re.compile(r"(ssh-|ecdsa-|sk-)")
KEYLINE_RE = re.compile(
    r'^(?P<opts>(?:[^\s"]|"(?:[^"\\]|\\.)*")+)\s+(?P<type>\S+)\s+(?P<blob>\S+)'
    r'(?:\s+(?P<comment>.*))?$')


# --- running things ----------------------------------------------------------

def system_run(argv, timeout=15):
    """Run a fixed argument list; return (exit_code, stdout, stderr)."""
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
           "LC_ALL": "C"}
    try:
        done = subprocess.run(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, env=env, timeout=timeout, shell=False,
            check=False, universal_newlines=True, errors="replace")
        return done.returncode, done.stdout, done.stderr
    except FileNotFoundError:
        return 127, "", "%s: command not found" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out" % argv[0]


class Host:
    """Everything doctor needs from the outside world, so tests can replace it."""

    def __init__(self, here=HERE, root="/", expected_uid=0, runner=system_run,
                 getpwnam=pwd.getpwnam, euid=None, settings_loader=None):
        self.here = here
        self.root = root
        self.expected_uid = expected_uid
        self.run = runner
        self.getpwnam = getpwnam
        self.euid = os.geteuid() if euid is None else euid
        self.settings_loader = settings_loader
        self._sshd = None

    def which(self, name):
        return shutil.which(name, path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")

    def p(self, path):
        """Map an absolute host path into the (possibly test) root."""
        if self.root == "/":
            return path
        return os.path.join(self.root, path.lstrip("/"))

    def template(self, *parts):
        return os.path.join(self.here, "etc", *parts)

    def sshd_effective(self):
        """(exit_code, parsed `sshd -T` for the service account, stderr). Cached."""
        if self._sshd is None:
            code, out, err = self.run(["sshd", "-T", "-C", SSHD_PROBE])
            self._sshd = (code, parse_sshd_t(out) if code == 0 else {}, err)
        return self._sshd


# --- the report --------------------------------------------------------------

class Report:
    def __init__(self):
        self.items = []          # (section, level, text, fix_lines)
        self.section_name = ""

    def section(self, name):
        self.section_name = name

    def add(self, level, text, fix=None):
        fixes = [fix] if isinstance(fix, str) else list(fix or [])
        self.items.append((self.section_name, level, text, fixes))

    def ok(self, text):
        self.add("ok", text)

    def info(self, text):
        self.add("info", text)

    def warn(self, text, fix=None):
        self.add("warn", text, fix)

    def fail(self, text, fix=None):
        self.add("fail", text, fix)

    def count(self, level):
        return sum(1 for item in self.items if item[1] == level)

    @property
    def failed(self):
        return self.count("fail") > 0


LEVEL_LABEL = {"ok": "ok  ", "info": "info", "warn": "WARN", "fail": "FAIL"}
LEVEL_COLOR = {"ok": "32", "info": "36", "warn": "33", "fail": "31"}


def render(report, out, color=False):
    def paint(level, text):
        return "\033[%sm%s\033[0m" % (LEVEL_COLOR[level], text) if color else text

    current = None
    for section, level, text, fixes in report.items:
        if section != current:
            out.write("\n%s\n" % section)
            current = section
        out.write("  [%s] %s\n" % (paint(level, LEVEL_LABEL[level]), text))
        for line in fixes:
            out.write("         fix: %s\n" % line)
    fails, warns = report.count("fail"), report.count("warn")
    out.write("\n")
    if fails:
        out.write("%d problem(s) need fixing, %d warning(s).\n" % (fails, warns))
    elif warns:
        out.write("No failures, %d warning(s).\n" % warns)
    else:
        out.write("Everything checked out.\n")


# --- small helpers -----------------------------------------------------------

def describe_owner(st):
    try:
        user = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        user = str(st.st_uid)
    try:
        group = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        group = str(st.st_gid)
    return "owned by %s:%s, mode %04o" % (user, group, stat.S_IMODE(st.st_mode))


def sha256_file(path):
    try:
        digest = hashlib.sha256()
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
        return digest.hexdigest()
    except OSError:
        return None


def read_bytes(path):
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        return None


def parse_sshd_t(text):
    parsed = {}
    for line in text.splitlines():
        key, _, value = line.partition(" ")
        if key:
            parsed.setdefault(key.lower(), []).append(value.strip())
    return parsed


def sshd_list(parsed, key):
    """Every value of an Allow/Deny Users/Groups setting from `sshd -T`.

    sshd prints these ONE LINE PER ENTRY ("allowusers alice", "allowusers bob";
    dump_cfg_strarray in OpenSSH's servconf.c, verified for 10.0p2), so all lines
    are collected, not just the first."""
    return " ".join(parsed.get(key, [])).split()


def ssh_pattern_matches(patterns, value):
    """Does any Allow/Deny entry match `value`, the way sshd judges them?

    sshd checks each entry on its own (allowed_user() in auth.c), so a lone
    '!pattern' entry can never match anything and does not veto other entries.
    `user@host` entries are judged on the user part only, which errs on the side
    of reporting a match.
    """
    for pattern in patterns:
        if pattern.startswith("!"):
            continue
        if fnmatch.fnmatchcase(value, pattern.split("@", 1)[0]):
            return True
    return False


def split_options(opts):
    """Split an authorized_keys option string on commas outside quotes."""
    parts, current, quoted, escaped = [], "", False, False
    for ch in opts:
        if escaped:
            current += ch
            escaped = False
        elif ch == "\\" and quoted:
            current += ch
            escaped = True
        elif ch == '"':
            current += ch
            quoted = not quoted
        elif ch == "," and not quoted:
            parts.append(current)
            current = ""
        else:
            current += ch
    parts.append(current)
    result = {}
    for part in parts:
        name, sep, value = part.partition("=")
        if sep and value.startswith('"') and value.endswith('"') and len(value) >= 2:
            value = value[1:-1].replace('\\"', '"')
        result[name.lower()] = value if sep else True
    return result


def install_command(ctx):
    return "sudo python3 %s install" % shlex.quote(os.path.join(ctx.here, "wgmanager-host"))


def secure_path(ctx, rep, path, label, want_dir=False, create_hint=None):
    """Report on a path that must be a real file/dir, root-owned, not writable by
    others. Returns the lstat result when the path exists, else None."""
    real = ctx.p(path)
    try:
        st = os.lstat(real)
    except OSError:
        rep.fail("%s is missing (%s)" % (label, path), create_hint)
        return None
    kind = stat.S_ISDIR if want_dir else stat.S_ISREG
    problems, fixes = [], []
    if not kind(st.st_mode):
        problems.append("is not a regular %s (a symlink?)" % ("directory" if want_dir else "file"))
        fixes.append("replace %s with a real %s" % (shlex.quote(path), "directory" if want_dir else "file"))
    else:
        if st.st_uid != ctx.expected_uid:
            problems.append("is not owned by root")
            fixes.append("sudo chown root:root %s" % shlex.quote(path))
        if st.st_mode & 0o022:
            problems.append("is writable by group or others")
            fixes.append("sudo chmod go-w %s" % shlex.quote(path))
    if problems:
        rep.fail("%s %s (%s; %s)" % (label, " and ".join(problems), path, describe_owner(st)), fixes)
    return st


# --- loading the helper (for the shared host rules) ---------------------------

def load_helper(ctx):
    sys.dont_write_bytecode = True       # never leave root-owned .pyc files in a checkout
    path = os.path.join(ctx.here, "wgmanager-helper")
    loader = importlib.machinery.SourceFileLoader("wgmanager_helper", path)
    spec = importlib.util.spec_from_loader("wgmanager_helper", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    module.log = lambda *args, **kwargs: None      # doctor must not write to the journal
    return module


PROBLEM_TEXT = {
    "missing": "is missing",
    "not_regular": "is not a regular file (a symlink or directory?)",
    "writable": "is writable by group or others",
    "not_root": "is not owned by root",
    "not_executable": "is not executable",
}


def problem_fix(path, kind):
    quoted = shlex.quote(path)
    if kind == "writable":
        return "sudo chmod go-w %s" % quoted
    if kind == "not_root":
        return "sudo chown root:root %s" % quoted
    if kind == "not_executable":
        return "sudo chmod +x %s" % quoted
    if kind == "missing":
        return ("is PiVPN with WireGuard installed? If it lives elsewhere, set the path "
                "in %s (see config.example)" % os.path.join(CONFIG_DIR, "config"))
    return "put a regular file at %s" % quoted


# --- the checks --------------------------------------------------------------

def check_privileges(ctx, rep):
    rep.section("This tool")
    if ctx.euid != 0:
        rep.fail("doctor must run as root so it can see every file it checks",
                 "sudo python3 %s doctor" % shlex.quote(os.path.join(ctx.here, "wgmanager-host")))
        return False
    rep.ok("running as root")
    return True


def check_platform(ctx, rep):
    text = (read_bytes(ctx.p("/etc/os-release")) or b"").decode("utf-8", "replace")
    fields = dict(
        (k, v.strip('"')) for k, _, v in
        (line.partition("=") for line in text.splitlines()) if k)
    family = ("%s %s" % (fields.get("ID", ""), fields.get("ID_LIKE", ""))).split()
    name = fields.get("PRETTY_NAME", "unknown OS")
    if {"debian", "ubuntu", "raspbian"} & set(family):
        rep.ok("%s (Debian family, like PiVPN itself)" % name)
    else:
        rep.warn("%s is not a Debian-family system; wgmanager is only tested with PiVPN "
                 "on Debian-based systems" % name)


def check_pivpn(ctx, rep, h):
    rep.section("PiVPN and WireGuard")
    try:
        settings = ctx.settings_loader(h) if ctx.settings_loader else \
            h.load_settings(ctx.p(h.DEFAULT_CONFIG_PATH), True)
    except h.HelperError:
        rep.fail("%s is not a valid settings file (unknown key, relative path, or "
                 "writable by others)" % os.path.join(CONFIG_DIR, "config"),
                 ["compare it with host/etc/wgmanager/config.example",
                  "or remove it to use the defaults"])
        return None
    problems = h.preflight_problems(settings)
    for what, path, kind in problems:
        if kind == "not_running_as_root":
            continue
        line = "%s %s (%s" % (what, PROBLEM_TEXT.get(kind, kind), path)
        try:
            st = os.stat(path)
            line += "; " + describe_owner(st)
        except OSError:
            pass
        rep.fail(line + ")", problem_fix(path, kind))
    if not problems:
        rep.ok("pivpn (%s) and wg (%s) found; PiVPN's data files and scripts are root-owned and not "
               "writable by others" % (settings.pivpn_exec, settings.wg_exec))

    backup_dir = settings.backup_dir
    try:
        st = os.lstat(backup_dir)
    except OSError:
        rep.info("backup directory %s does not exist yet (created on the first change)" % backup_dir)
    else:
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != ctx.expected_uid or st.st_mode & 0o077:
            rep.warn("backup directory should be a root-owned directory with mode 0700 "
                     "(%s; %s)" % (backup_dir, describe_owner(st)),
                     ["sudo chown root:root %s && sudo chmod 700 %s"
                      % (shlex.quote(backup_dir), shlex.quote(backup_dir))])
        else:
            rep.ok("backup directory %s is private" % backup_dir)
    return settings


def check_helper_file(ctx, rep, h):
    rep.section("Installed helper")
    secure_path(ctx, rep, HELPER_DIR, "helper directory", want_dir=True)
    install_hint = "sudo python3 %s install" % shlex.quote(os.path.join(ctx.here, "wgmanager-host"))
    st = secure_path(ctx, rep, HELPER_PATH, "helper", create_hint=install_hint)
    if st is None:
        return
    if not os.access(ctx.p(HELPER_PATH), os.X_OK):
        rep.fail("helper is not executable (%s)" % HELPER_PATH, "sudo chmod 755 %s" % HELPER_PATH)
    mine = sha256_file(os.path.join(ctx.here, "wgmanager-helper"))
    installed = sha256_file(ctx.p(HELPER_PATH))
    if mine and installed == mine:
        rep.ok("helper %s matches this checkout (version %s)" % (HELPER_PATH, h.HELPER_VERSION))
    else:
        rep.warn("the installed helper differs from this checkout (checkout is version %s)"
                 % h.HELPER_VERSION, install_hint)


def check_account(ctx, rep):
    rep.section("Service account")
    try:
        pw = ctx.getpwnam(ACCOUNT)
    except KeyError:
        rep.fail("user %s does not exist" % ACCOUNT,
                 "sudo python3 %s install" % shlex.quote(os.path.join(ctx.here, "wgmanager-host")))
        return
    if pw.pw_uid >= 1000:
        rep.warn("%s has uid %d: it looks like a regular user, not a system account" % (ACCOUNT, pw.pw_uid))
    else:
        rep.ok("%s is a system account (uid %d)" % (ACCOUNT, pw.pw_uid))
    shell = os.path.basename(pw.pw_shell or "")
    if shell in ("nologin", "false", ""):
        rep.fail("%s has shell %s, so sshd cannot run the forced command" % (ACCOUNT, pw.pw_shell or "(none)"),
                 "sudo usermod --shell /bin/sh %s" % ACCOUNT)

    code, out, _ = ctx.run(["id", "-nG", ACCOUNT])
    groups = out.split() if code == 0 else []
    bad = sorted(set(groups) & PRIVILEGED_GROUPS)
    if bad:
        rep.fail("%s is in privileged group(s): %s" % (ACCOUNT, ", ".join(bad)),
                 ["sudo gpasswd -d %s %s" % (ACCOUNT, g) for g in bad])
    elif code == 0:
        rep.ok("%s is in no privileged groups (%s)" % (ACCOUNT, ", ".join(groups) or "none"))

    code, out, _ = ctx.run(["getent", "shadow", ACCOUNT])
    if code == 0:
        field = out.strip().split(":")[1] if ":" in out else ""
        usepam = (ctx.sshd_effective()[1].get("usepam") or ["unknown"])[0]
        if field == "":
            rep.fail("%s has an EMPTY password" % ACCOUNT, "sudo usermod -p '*' %s" % ACCOUNT)
        elif field.startswith("!") and usepam == "no":
            rep.fail("%s is locked and sshd has UsePAM off; sshd refuses key logins for "
                     "locked accounts" % ACCOUNT,
                     ["sudo usermod -p '*' %s   (no usable password, but not locked)" % ACCOUNT])
        elif field.startswith("$"):
            rep.warn("%s has a password set; it needs none (password login is disabled "
                     "for it anyway)" % ACCOUNT, "sudo usermod -p '*' %s" % ACCOUNT)
        else:
            rep.ok("%s has no usable password (key login only)" % ACCOUNT)


def check_sudo(ctx, rep):
    rep.section("sudo rule")
    st = secure_path(ctx, rep, SUDOERS_PATH, "sudoers file", create_hint=install_command(ctx))
    if st is not None:
        if stat.S_IMODE(st.st_mode) & 0o037:
            rep.fail("sudoers file mode should be 0440 (%s)" % describe_owner(st),
                     "sudo chmod 0440 %s" % SUDOERS_PATH)
        mine = read_bytes(ctx.template("sudoers.d", "wgmanager"))
        if mine is not None and read_bytes(ctx.p(SUDOERS_PATH)) != mine:
            rep.warn("the installed sudoers file differs from this checkout")
        code, out, err = ctx.run(["visudo", "-cf", SUDOERS_PATH])
        if code == 0:
            rep.ok("sudoers file parses cleanly")
        else:
            rep.fail("sudoers file does not parse: %s"
                     % ((err or out).strip().splitlines() or ["visudo failed"])[0],
                     "sudo rm -f %s   (then reinstall)" % SUDOERS_PATH)

    code, out, err = ctx.run(["sudo", "-n", "-l", "-U", ACCOUNT])
    text = out + err
    if st is None:
        pass          # already reported as missing; a second failure would only repeat it
    elif code != 0 or "not allowed to run sudo" in text:
        rep.fail("%s is not allowed to run any sudo command, so the helper cannot be reached" % ACCOUNT)
    else:
        lines = text.splitlines()
        rules = []
        seen = False
        for line in lines:
            if "may run the following commands" in line:
                seen = True
                continue
            if seen and line.strip().startswith("("):
                rules.append(" ".join(line.split()))
        if rules == [SUDO_RULE]:
            rep.ok("%s may run exactly one command via sudo: the helper with --ssh" % ACCOUNT)
        elif SUDO_RULE in rules:
            extra = [r for r in rules if r != SUDO_RULE]
            rep.fail("%s can run more than the helper: %s" % (ACCOUNT, "; ".join(extra)),
                     "remove the extra sudoers rule(s) for %s" % ACCOUNT)
        else:
            rep.fail("%s lacks the helper rule (sudo reports: %s)" % (ACCOUNT, "; ".join(rules) or "nothing"))

    code, out, err = ctx.run(["visudo", "-c"])
    if code != 0:
        # Not necessarily ours: a different broken file makes sudo unusable for everyone.
        details = [ln.strip() for ln in (out + err).splitlines()
                   if "bad permissions" in ln or "parse error" in ln or "syntax" in ln][:3]
        fixes = []
        for ln in details:
            match = re.match(r"(/\S+): bad permissions, should be mode (\d+)", ln)
            if match:
                fixes.append("sudo chmod %s %s" % (match.group(2), match.group(1)))
        rep.warn("sudo reports a problem somewhere in its configuration (possibly not wgmanager's): %s"
                 % ("; ".join(details) or "run visudo -c for details"), fixes)


def check_sshd(ctx, rep):
    rep.section("sshd")
    dropin_st = secure_path(ctx, rep, SSHD_DROPIN_PATH, "sshd drop-in", create_hint=install_command(ctx))
    mine = read_bytes(ctx.template("ssh", "sshd_config.d", "wgmanager.conf"))
    if mine is not None and os.path.exists(ctx.p(SSHD_DROPIN_PATH)) \
            and read_bytes(ctx.p(SSHD_DROPIN_PATH)) != mine:
        rep.warn("the installed sshd drop-in differs from this checkout")

    code, _, err = ctx.run(["sshd", "-t"])
    if code == 0:
        rep.ok("sshd configuration is valid (sshd -t)")
    else:
        first = (err.strip().splitlines() or ["sshd -t failed"])[0]
        rep.fail("sshd configuration is invalid: %s" % first)

    code, eff, err = ctx.sshd_effective()
    if code != 0:
        rep.fail("could not ask sshd for its effective settings: %s"
                 % ((err.strip().splitlines() or ["sshd -T failed"])[0]))
        return

    if dropin_st is None:
        pass          # the drop-in file is missing (reported above); nothing to compare yet
    elif not eff.get("forcecommand") or eff["forcecommand"][0] in ("none", ""):
        rep.fail("sshd is not applying the wgmanager drop-in to user %s" % ACCOUNT,
                 ["make sure /etc/ssh/sshd_config contains: Include /etc/ssh/sshd_config.d/*.conf",
                  "then: sudo sshd -t && sudo systemctl reload ssh"])
    else:
        bad = 0
        for key, want in SSHD_EXPECT:
            names = (key,) + SSHD_ALIASES.get(key, ())
            got = next((eff[n][0] for n in names if n in eff), None)
            if got is None:
                mismatch = True
            elif key in ("forcecommand", "authorizedkeysfile"):
                mismatch = got != want
            else:
                mismatch = BOOLEAN_WORDS.get(got.lower(), got.lower()) != want.lower()
            if mismatch:
                bad += 1
                rep.fail("sshd reports %s = %s for %s, expected %s" % (key, got or "(unset)", ACCOUNT, want),
                         ["another sshd setting is overriding ours: sshd uses the FIRST value it finds, "
                          "so check files in /etc/ssh/sshd_config.d/ that sort before wgmanager.conf",
                          "inspect with: sudo sshd -T -C %s | grep -i %s" % (SSHD_PROBE, key)])
        if not bad:
            rep.ok("sshd restricts %s to key login and the forced helper command "
                   "(no tty, no forwarding)" % ACCOUNT)

    groups_code, groups_out, _ = ctx.run(["id", "-nG", ACCOUNT])
    groups = groups_out.split() if groups_code == 0 else [ACCOUNT]
    for key, kind in (("allowusers", "user"), ("allowgroups", "group")):
        if eff.get(key):
            patterns = sshd_list(eff, key)
            values = [ACCOUNT] if kind == "user" else groups
            if not any(ssh_pattern_matches(patterns, v) for v in values):
                rep.fail("sshd %s does not include %s (it lists: %s), so it can never log in"
                         % (SSHD_KEY_NAMES[key],
                            ACCOUNT if kind == "user" else "its group", " ".join(patterns)),
                         "add %s to %s in /etc/ssh/sshd_config (or a drop-in), then reload sshd"
                         % (ACCOUNT if kind == "user" else "its group", key))
            else:
                rep.ok("sshd %s allows %s" % (key, ACCOUNT))
    for key, kind in (("denyusers", "user"), ("denygroups", "group")):
        if eff.get(key):
            patterns = sshd_list(eff, key)
            values = [ACCOUNT] if kind == "user" else groups
            if any(ssh_pattern_matches(patterns, v) for v in values):
                rep.fail("sshd %s blocks %s" % (key, ACCOUNT),
                         "remove the matching entry from %s, then reload sshd" % key)

    port = (eff.get("port") or ["22"])[0]
    listen = ", ".join(eff.get("listenaddress", []))
    rep.info("sshd listens on port %s%s (set this as the SSH port for the web app)"
             % (port, " (%s)" % listen if listen else ""))


def host_fingerprints(ctx):
    """Fingerprints of the ED25519 host keys sshd actually uses.

    `sshd -T` prints one "hostkey <path>" line per HostKey (dump_cfg_strarray in
    OpenSSH's servconf.c; seen on 9.6p1). The web app pins the server's ED25519
    key, so that is the one the admin compares. The fingerprint is OpenSSH's
    SHA256 form: base64 of the SHA-256 of the key blob, without padding (the
    same value `ssh-keygen -lf` prints)."""
    code, parsed, _ = ctx.sshd_effective()
    if code != 0:
        return None
    found = []
    for path in parsed.get("hostkey", []):
        text = (read_bytes(ctx.p(path + ".pub")) or b"").decode("ascii", "replace").split()
        if len(text) >= 2 and text[0] == "ssh-ed25519":
            try:
                blob = base64.b64decode(text[1], validate=True)
            except ValueError:
                continue
            digest = base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
            found.append("SHA256:" + digest)
    return found


def check_host_key(ctx, rep):
    rep.section("server identity")
    found = host_fingerprints(ctx)
    if found is None:
        rep.info("could not read sshd's host keys (sshd -T failed; see the sshd section)")
    elif found:
        for fp in found:
            rep.ok("ED25519 host key fingerprint: %s (compare it in the web UI)" % fp)
    else:
        rep.warn("sshd has no ED25519 host key; the web app only accepts an ED25519 server key",
                 ["sudo ssh-keygen -A   (creates any missing default host keys)",
                  "make sure sshd uses /etc/ssh/ssh_host_ed25519_key (no HostKey lines, or one for it)",
                  "then: sudo systemctl reload ssh"])


def check_authorized_keys(ctx, rep):
    rep.section("Authorized key")
    if secure_path(ctx, rep, CONFIG_DIR, "config directory", want_dir=True,
                   create_hint=install_command(ctx)) is None:
        return
    if not os.path.lexists(ctx.p(AUTHORIZED_KEYS_PATH)):
        rep.warn("no authorized_keys file yet, so the web app cannot connect",
                 "install the app's public key with: sudo python3 %s install --pubkey-file <file>"
                 % shlex.quote(os.path.join(ctx.here, "wgmanager-host")))
        return
    st = secure_path(ctx, rep, AUTHORIZED_KEYS_PATH, "authorized_keys")
    if st is None:
        return
    text = (read_bytes(ctx.p(AUTHORIZED_KEYS_PATH)) or b"").decode("utf-8", "replace")
    keys = 0
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = KEYLINE_RE.match(line)
        where = "authorized_keys line %d" % number
        if not match or KEY_TYPES_RE.match(match.group("opts")):
            rep.fail("%s has no options in front of the key; it would not be restricted to the helper" % where)
            continue
        keys += 1
        opts = split_options(match.group("opts"))
        problems = 0
        if opts.get("command") != FORCED_COMMAND:
            problems += 1
            rep.fail("%s does not force the helper command" % where,
                     'start the line with: command="%s",restrict,from="..."' % FORCED_COMMAND)
        if "restrict" not in opts:
            problems += 1
            rep.warn("%s lacks the 'restrict' option" % where)
        sources = opts.get("from")
        if not isinstance(sources, str) or not sources:
            problems += 1
            rep.warn("%s has no from= restriction, so the key works from any address" % where,
                     'add from="<container subnet>" to the options')
        elif any(s.strip() in ("*", "0.0.0.0/0", "::/0") for s in sources.split(",")):
            problems += 1
            rep.warn("%s allows any source address (from=%s)" % (where, sources))
        else:
            for item in sources.split(","):
                item = item.strip()
                # Only CIDR entries are judged: sshd rejects a bad one and then the
                # whole list. Wildcard host patterns (no "/") are legal for sshd.
                problem = source_problem(item) if "/" in item else None
                if problem:
                    problems += 1
                    rep.fail("%s: from= entry %s" % (where, problem),
                             "reinstall the key with a corrected --allow-from")
        if match.group("type") != "ssh-ed25519":
            rep.warn("%s uses key type %s (ssh-ed25519 is recommended)" % (where, match.group("type")))
        if not problems:
            rep.ok("key %d (%s) is limited to the helper command, allowed from: %s"
                   % (keys, match.group("comment") or "no comment", sources))
    if keys == 0:
        rep.warn("no keys are installed yet, so the web app cannot connect",
                 "install the app's public key with: sudo python3 %s install --pubkey-file <file>"
                 % shlex.quote(os.path.join(ctx.here, "wgmanager-host")))


HELPER_HINTS = {
    "host_misconfigured": "see the PiVPN section above; the helper's own log has the path "
                          "(sudo journalctl -t wgmanager-helper -n 20)",
    "busy": "another change was in progress; run doctor again",
    "invalid_request": "the helper rejected the request; is the installed helper an old version? "
                       "run install to update it",
}


def call_helper(ctx, request):
    code, out, err = ctx.run(["sudo", "-n", "-u", ACCOUNT, "env", "SSH_ORIGINAL_COMMAND=" + request,
                              "sudo", "-n", HELPER_PATH, "--ssh"])
    try:
        return code, json.loads(out), err
    except ValueError:
        return code, None, err or out


def check_end_to_end(ctx, rep):
    rep.section("End to end (as the web app would call it)")
    try:
        ctx.getpwnam(ACCOUNT)
        ready = os.path.exists(ctx.p(HELPER_PATH)) and os.path.exists(ctx.p(SUDOERS_PATH))
    except KeyError:
        ready = False
    if not ready:
        rep.info("skipped: needs the helper, the sudo rule and the %s account (see above)" % ACCOUNT)
        return
    code, resp, err = call_helper(ctx, "version")
    if resp is None:
        rep.fail("calling the helper through sudo failed: %s"
                 % ((err.strip().splitlines() or ["no output"])[0]),
                 "fix the sudo rule and helper installation first (see above)")
        return
    if not resp.get("ok"):
        error = (resp.get("error") or {}).get("code", "unknown")
        rep.fail("the helper answered with error '%s'" % error, HELPER_HINTS.get(error))
        return
    data = resp["data"]
    rep.ok("helper %s (protocol %s, backend %s, interface %s) answered via sudo"
           % (data.get("helper_version"), data.get("protocol"), data.get("backend"), data.get("interface")))

    code, resp, err = call_helper(ctx, "list")
    if resp is None or not resp.get("ok"):
        error = ((resp or {}).get("error") or {}).get("code", "no answer")
        rep.fail("listing clients failed (%s)" % error, HELPER_HINTS.get(error))
        return
    data = resp["data"]
    clients = data["clients"]
    live = sum(1 for c in clients if c.get("live"))
    enabled = sum(1 for c in clients if c.get("enabled"))
    iface = data.get("interface", {})
    rep.ok("%d client(s): %d enabled, %d live" % (len(clients), enabled, live))
    if not iface.get("up"):
        rep.warn("WireGuard interface %s is not up" % iface.get("name"))
    unmanageable = [c["name"] for c in clients if not c.get("manageable", True)]
    if unmanageable:
        rep.warn("%d client(s) cannot be managed because PiVPN allows names wgmanager refuses: %s"
                 % (len(unmanageable), ", ".join(unmanageable)))
    for warning in data.get("warnings", [])[:5]:
        rep.warn("helper warning: %s" % warning)


# --- installing --------------------------------------------------------------
#
# install and uninstall share one shape: look at the host, build a PLAN (a list
# of steps, each marked create / replace / unchanged), show it, ask, then apply.
# install undoes what it did if any step fails; uninstall is best effort and can
# simply be run again.

DEFAULT_CONTAINER_SUBNET = "172.29.88.0/29"      # pinned in the compose file too
DEFAULT_SOURCES = ("127.0.0.1", "::1", DEFAULT_CONTAINER_SUBNET)
ACCOUNT_COMMENT = "wgmanager service account"
ALLOWED_KEY_TYPES = ("ssh-ed25519", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384",
                     "ecdsa-sha2-nistp521", "ssh-rsa")
KEYS_HEADER = ("# Managed by wgmanager-host. Each key may only run the helper, and only from\n"
               "# the listed addresses. Edit with: wgmanager-host install --pubkey-file ...\n")


class InstallError(Exception):
    """A problem that stops install/uninstall; the message is shown to the user."""


class Step:
    def __init__(self, title, state, apply=None, undo=None):
        self.title, self.state, self.apply, self.undo = title, state, apply, undo


def parse_pubkey(text):
    """Validate a public key and return its parts. Refuses anything that could
    smuggle options or a private key into authorized_keys."""
    text = text.strip()
    if "PRIVATE KEY" in text:
        raise InstallError("that is a PRIVATE key. Never share it; use the public half "
                           "(the .pub file, a single line starting with ssh-ed25519)")
    lines = [ln for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#")]
    if len(lines) != 1:
        raise InstallError("expected exactly one public key line, found %d" % len(lines))
    parts = lines[0].split(None, 2)
    if len(parts) < 2 or parts[0] not in ALLOWED_KEY_TYPES:
        raise InstallError("the key must start with a key type (%s); options such as command= "
                           "are not accepted, the tool adds its own" % ", ".join(ALLOWED_KEY_TYPES))
    try:
        blob = base64.b64decode(parts[1], validate=True)
        size = struct.unpack(">I", blob[:4])[0]
        embedded = blob[4:4 + size].decode("ascii")
    except (ValueError, struct.error, UnicodeDecodeError):
        raise InstallError("the key data is not valid base64 public key material")
    if embedded != parts[0]:
        raise InstallError("the key type (%s) does not match the key data (%s)" % (parts[0], embedded))
    comment = re.sub(r"[^A-Za-z0-9_.@-]", "_", parts[2].strip() if len(parts) > 2 else "")[:64]
    return {
        "type": parts[0], "b64": parts[1], "blob": blob, "comment": comment or "wgmanager",
        "fingerprint": "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("="),
    }


def source_problem(item):
    """Why OpenSSH would reject `item` in from=, or None if it is a clean address/network.

    OpenSSH refuses a network with host bits set (10.0.0.5/24) and then rejects
    the WHOLE from= list, so the key stops working from every address.
    """
    try:
        ipaddress.ip_network(item, strict=True)
        return None
    except ValueError:
        pass
    try:
        network = ipaddress.ip_network(item, strict=False)
    except ValueError:
        return ("'%s' is not an IP address or CIDR network (host names and "
                "wildcards are not accepted)" % item)
    return ("'%s' has host bits set, which sshd rejects (and then refuses the key from "
            "every address); did you mean %s?" % (item, network))


def parse_sources(text):
    """Validate a comma-separated list of IP addresses / CIDR networks."""
    sources = []
    for item in text.split(","):
        item = item.strip()
        if not item:
            continue
        problem = source_problem(item)
        if problem:
            raise InstallError(problem)
        network = ipaddress.ip_network(item, strict=True)
        if network.prefixlen == 0:
            raise InstallError("'%s' would allow every address; give the container network "
                               "(for example %s)" % (item, DEFAULT_CONTAINER_SUBNET))
        sources.append(item)
    if not sources:
        raise InstallError("no source addresses given")
    return sources


def key_line(key, sources):
    return 'command="%s",restrict,from="%s" %s %s %s\n' % (
        FORCED_COMMAND, ",".join(sources), key["type"], key["b64"], key["comment"])


def keys_file_text(key, sources):
    return KEYS_HEADER + key_line(key, sources)


def existing_blobs(text):
    blobs = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = KEYLINE_RE.match(line)
        if match:
            blobs.append(match.group("blob"))
    return blobs


def write_atomic(ctx, path, data, mode, validate=None):
    """Write `data` to `path` via a temp file in the same directory (a name sudo
    and sshd both ignore), validate it there, then rename into place."""
    real = ctx.p(path)
    directory = os.path.dirname(real)
    if not os.path.isdir(directory):
        raise InstallError("directory %s does not exist" % os.path.dirname(path))
    try:
        st = os.lstat(real)
        if not stat.S_ISREG(st.st_mode):
            raise InstallError("%s exists and is not a regular file; refusing to replace it" % path)
    except FileNotFoundError:
        pass
    tmp = os.path.join(directory, ".wgmanager-install.%d.tmp" % os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fchmod(handle.fileno(), mode)
            if ctx.root == "/":
                os.fchown(handle.fileno(), 0, 0)
            os.fsync(handle.fileno())
        if validate:
            validate(tmp)
        os.replace(tmp, real)
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def restore(ctx, path, previous, mode):
    """Put a file back to what it was (previous bytes), or remove it."""
    real = ctx.p(path)
    if previous is None:
        if os.path.lexists(real):
            os.unlink(real)
    else:
        write_atomic(ctx, path, previous, mode)


def file_step(ctx, title, path, data, mode, validate=None):
    """A step that installs `data` at `path`; its undo restores what was there.

    Built by a function so every step keeps its OWN copy of the previous content
    (closures in a loop or a long function would all share the last one).
    """
    state, previous = state_of(ctx, path, data)
    return Step(title, state,
                lambda: write_atomic(ctx, path, data, mode, validate),
                lambda: restore(ctx, path, previous, mode))


def dir_problem(ctx, path):
    try:
        st = os.lstat(ctx.p(path))
    except OSError:
        return "does not exist"
    if not stat.S_ISDIR(st.st_mode):
        return "is not a directory"
    if st.st_uid != ctx.expected_uid:
        return "is not owned by root"
    if st.st_mode & 0o022:
        return "is writable by group or others"
    return None


def state_of(ctx, path, wanted):
    current = read_bytes(ctx.p(path))
    if current is None:
        return "create", None
    return ("unchanged" if current == wanted else "replace"), current


def service_name(ctx):
    for name in ("ssh", "sshd"):
        if ctx.run(["systemctl", "is-active", name])[0] == 0:
            return name
    return None


def preflight_install(ctx, h, args):
    """Everything that must be true before we touch anything. Raises InstallError."""
    if ctx.euid != 0:
        raise InstallError("must run as root: sudo python3 %s"
                           % os.path.join(ctx.here, "wgmanager-host"))
    for tool in ("useradd", "visudo", "sshd", "systemctl"):
        if not ctx.which(tool):
            raise InstallError("required tool not found: %s" % tool)
    try:
        settings = ctx.settings_loader(h) if ctx.settings_loader else \
            h.load_settings(ctx.p(h.DEFAULT_CONFIG_PATH), True)
    except h.HelperError:
        raise InstallError("%s is not a valid settings file; run doctor for details"
                           % os.path.join(CONFIG_DIR, "config"))
    problems = h.preflight_problems(settings)
    if problems:
        raise InstallError("the PiVPN/WireGuard side of this host has problems (%s); "
                           "run 'doctor' to see each one with its fix, then try again"
                           % ", ".join("%s %s" % (w, k) for w, _, k in problems))
    problem = dir_problem(ctx, HELPER_DIR)
    if problem:
        raise InstallError("%s %s; refusing to install a root-run program there" % (HELPER_DIR, problem))

    # sshd must load drop-ins, and the whole config must already be valid.
    config = (read_bytes(ctx.p("/etc/ssh/sshd_config")) or b"").decode("utf-8", "replace")
    if not re.search(r"^\s*Include\s+\S*sshd_config\.d", config, re.I | re.M):
        raise InstallError("/etc/ssh/sshd_config has no 'Include /etc/ssh/sshd_config.d/*.conf' line, "
                           "so sshd would ignore our drop-in. wgmanager never edits your main sshd "
                           "config; add that line yourself, then run install again")
    code, _, err = ctx.run(["sshd", "-t"])
    if code != 0:
        raise InstallError("sshd's configuration is already invalid, so it is not safe to add to it: %s"
                           % ((err.strip().splitlines() or ["sshd -t failed"])[0]))
    code, eff, err = ctx.run(["sshd", "-T"])
    if code == 0:
        parsed = parse_sshd_t(eff)
        for key in ("allowusers", "allowgroups"):
            if parsed.get(key):
                # The account will get a same-named primary group, so one name covers both.
                if not ssh_pattern_matches(sshd_list(parsed, key), ACCOUNT):
                    raise InstallError("sshd %s is set (%s) and does not include %s, so it could never "
                                       "log in. Add %s to it (or a group matching it), then run install "
                                       "again" % (SSHD_KEY_NAMES[key], " ".join(sshd_list(parsed, key)),
                                                  ACCOUNT, ACCOUNT))
        for key in ("denyusers",):
            if parsed.get(key) and ssh_pattern_matches(sshd_list(parsed, key), ACCOUNT):
                raise InstallError("sshd DenyUsers blocks %s" % ACCOUNT)
    unit = service_name(ctx)
    if unit is None:
        raise InstallError("could not find a running ssh service (tried 'ssh' and 'sshd'). On "
                           "systems where sshd is socket-activated, connect over SSH once so the "
                           "service is running, then run install again")
    return unit, settings


def plan_install(ctx, h, args):
    unit, settings = preflight_install(ctx, h, args)
    notes, steps = [], []

    # inputs
    key = None
    if args.pubkey_file and args.pubkey:
        raise InstallError("give either --pubkey-file or --pubkey, not both")
    if args.pubkey_file:
        try:
            text = read_bytes(args.pubkey_file)
        except OSError:
            text = None
        if text is None:
            raise InstallError("cannot read %s" % args.pubkey_file)
        if len(text) > 8192:
            raise InstallError("%s is too large to be a public key" % args.pubkey_file)
        key = parse_pubkey(text.decode("utf-8", "replace"))
    elif args.pubkey:
        key = parse_pubkey(args.pubkey)
    sources = parse_sources(args.allow_from) if args.allow_from else list(DEFAULT_SOURCES)
    vpn = h.read_vpn_subnet(settings)
    overlapping = [s for s in sources
                   if vpn is not None and ipaddress.ip_network(s).version == 4
                   and ipaddress.ip_network(s).overlaps(vpn)]

    # service account
    try:
        pw = ctx.getpwnam(ACCOUNT)
    except KeyError:
        pw = None
    password_field = None
    if pw is not None:
        if pw.pw_uid >= 1000 or os.path.basename(pw.pw_shell or "") in ("nologin", "false", ""):
            raise InstallError("a user named %s already exists and is not a suitable system account "
                               "(uid %d, shell %s); rename or remove it first"
                               % (ACCOUNT, pw.pw_uid, pw.pw_shell))
        code, out, _ = ctx.run(["id", "-nG", ACCOUNT])
        bad = sorted(set(out.split() if code == 0 else []) & PRIVILEGED_GROUPS)
        if bad:
            # Not ours to change: someone put it there, so a person should decide.
            raise InstallError("user %s is in privileged group(s) %s, which would give the web app's "
                               "key far more power than the helper. Remove it first: %s"
                               % (ACCOUNT, ", ".join(bad),
                                  "; ".join("sudo gpasswd -d %s %s" % (ACCOUNT, g) for g in bad)))
        code, out, _ = ctx.run(["getent", "shadow", ACCOUNT])
        if code == 0 and ":" in out:
            password_field = out.strip().split(":")[1]
    if overlapping:
        notes.append("--allow-from %s overlaps the VPN client subnet %s. That is fine if the app "
                     "deliberately connects over the VPN; a Docker network must never overlap it."
                     % (", ".join(overlapping), vpn))
    helper_bytes = read_bytes(os.path.join(ctx.here, "wgmanager-helper"))
    if helper_bytes is None:
        raise InstallError("cannot read wgmanager-helper next to this script")
    sudoers_bytes = read_bytes(ctx.template("sudoers.d", "wgmanager"))
    dropin_bytes = read_bytes(ctx.template("ssh", "sshd_config.d", "wgmanager.conf"))
    if sudoers_bytes is None or dropin_bytes is None:
        raise InstallError("the host/etc templates are missing next to this script")

    # 1. helper
    steps.append(file_step(ctx, "helper program %s (0755, root)" % HELPER_PATH,
                           HELPER_PATH, helper_bytes, 0o755))

    # 2. account
    def make_account():
        # Password field "*": no password can ever match, but the account is not
        # "locked" ("!"), which sshd refuses for key logins when UsePAM is off.
        code, _, err = ctx.run(["useradd", "--system", "--user-group", "--home-dir", "/nonexistent",
                                "--no-create-home", "--shell", "/bin/sh", "--password", "*",
                                "--comment", ACCOUNT_COMMENT, ACCOUNT])
        if code != 0:
            raise InstallError("useradd failed: %s" % ((err.strip().splitlines() or ["?"])[0]))

    def remove_account():
        ctx.run(["userdel", ACCOUNT])
    steps.append(Step("service account %s (system user, no home, no password)" % ACCOUNT,
                      "unchanged" if pw else "create", make_account, remove_account))

    if pw is not None and password_field is not None and password_field != "*":
        def set_no_password():
            code, _, err = ctx.run(["usermod", "--password", "*", ACCOUNT])
            if code != 0:
                raise InstallError("usermod failed: %s" % ((err.strip().splitlines() or ["?"])[0]))
        # No undo: "*" is never less safe than what was there (locked, empty or a real password).
        steps.append(Step("password field of %s set to '*' (no usable password, not locked)" % ACCOUNT,
                          "replace", set_no_password, lambda: None))

    # 3. config directory (ours, so an existing loose one is tightened, not just reported)
    try:
        dir_st = os.lstat(ctx.p(CONFIG_DIR))
    except FileNotFoundError:
        dir_st = None
    if dir_st is not None and not stat.S_ISDIR(dir_st.st_mode):
        raise InstallError("%s exists but is not a directory (a symlink or file?); move it aside "
                           "and run install again" % CONFIG_DIR)
    if dir_st is None:
        dir_state = "create"
    elif dir_st.st_uid != ctx.expected_uid or dir_st.st_mode & 0o022:      # doctor's rule
        dir_state = "replace"
    else:
        dir_state = "unchanged"

    def make_config_dir():
        os.makedirs(ctx.p(CONFIG_DIR), mode=0o755, exist_ok=True)
        if ctx.root == "/":
            os.chown(CONFIG_DIR, 0, 0)
        os.chmod(ctx.p(CONFIG_DIR), 0o755)

    def undo_config_dir():
        if dir_st is None:
            try:
                os.rmdir(ctx.p(CONFIG_DIR))
            except OSError:
                pass
        else:
            if ctx.root == "/":
                os.chown(CONFIG_DIR, dir_st.st_uid, dir_st.st_gid)
            os.chmod(ctx.p(CONFIG_DIR), stat.S_IMODE(dir_st.st_mode))
    steps.append(Step("config directory %s (0755, root)%s"
                      % (CONFIG_DIR, "; tightening its owner/mode" if dir_state == "replace" else ""),
                      dir_state, make_config_dir, undo_config_dir))

    # 4. authorized key
    if key is None:
        current = read_bytes(ctx.p(AUTHORIZED_KEYS_PATH))
        notes.append("No --pubkey-file given: the key is not installed. Run install again with "
                     "the app's public key once it exists%s." %
                     (" (a key is already installed and was left alone)"
                      if current and existing_blobs(current.decode('utf-8', 'replace')) else ""))
    else:
        wanted = keys_file_text(key, sources).encode()
        current = read_bytes(ctx.p(AUTHORIZED_KEYS_PATH))
        if current is not None and current != wanted:
            have = existing_blobs(current.decode("utf-8", "replace"))
            if any(blob != key["b64"] for blob in have) and not args.replace_key:
                raise InstallError("%s already holds a different key. To replace it, run install "
                                   "again with --replace-key" % AUTHORIZED_KEYS_PATH)
        steps.append(file_step(
            ctx, "authorized key %s %s (limited to the helper command, from: %s)"
            % (key["type"], key["fingerprint"], ", ".join(sources)),
            AUTHORIZED_KEYS_PATH, wanted, 0o644))

    # 5. sudo rule (validated in a temp file before it is put in place)
    def check_sudoers(tmp):
        code, out, err = ctx.run(["visudo", "-cf", tmp])
        if code != 0:
            raise InstallError("visudo rejected the sudo rule: %s"
                               % ((err or out).strip().splitlines() or ["?"])[0])
    steps.append(file_step(
        ctx, "sudo rule %s (0440): %s may run only the helper with --ssh" % (SUDOERS_PATH, ACCOUNT),
        SUDOERS_PATH, sudoers_bytes, 0o440, check_sudoers))

    # 6. sshd drop-in, last: it is the only step that changes who can log in
    state, dropin_previous = state_of(ctx, SSHD_DROPIN_PATH, dropin_bytes)
    reloaded = []

    def apply_sshd():
        os.makedirs(ctx.p(os.path.dirname(SSHD_DROPIN_PATH)), exist_ok=True)
        write_atomic(ctx, SSHD_DROPIN_PATH, dropin_bytes, 0o644)
        code, _, err = ctx.run(["sshd", "-t"])
        if code != 0:
            raise InstallError("sshd rejected the new configuration: %s"
                               % ((err.strip().splitlines() or ["?"])[0]))
        code, eff, _ = ctx.run(["sshd", "-T", "-C", SSHD_PROBE])
        forced = parse_sshd_t(eff).get("forcecommand", [""])[0] if code == 0 else ""
        if forced != FORCED_COMMAND:
            raise InstallError("sshd did not pick up the drop-in (forcecommand is '%s')" % (forced or "unset"))
        code, _, err = ctx.run(["systemctl", "reload", unit])
        if code != 0:
            raise InstallError("could not reload sshd: %s" % ((err.strip().splitlines() or ["?"])[0]))
        reloaded.append(True)

    def undo_sshd():
        restore(ctx, SSHD_DROPIN_PATH, dropin_previous, 0o644)
        if reloaded and ctx.run(["sshd", "-t"])[0] == 0:
            ctx.run(["systemctl", "reload", unit])
    steps.append(Step(
        "sshd drop-in %s (0644) + reload %s; existing SSH sessions are not affected" % (SSHD_DROPIN_PATH, unit),
        state, apply_sshd, undo_sshd))
    return steps, notes


def run_steps(steps, out):
    """Apply steps in order; on failure undo the ones already applied."""
    done = []
    try:
        for step in steps:
            if step.state == "unchanged":
                continue
            out.write("  ... %s\n" % step.title)
            done.append(step)
            step.apply()
    except Exception as exc:                      # includes InstallError
        out.write("\nFAILED: %s\nRolling back what was changed ...\n" % exc)
        for step in reversed(done):
            try:
                step.undo()
                out.write("  undone: %s\n" % step.title)
            except Exception as undo_exc:         # keep going; report honestly
                out.write("  COULD NOT UNDO (%s): %s\n" % (undo_exc, step.title))
        raise InstallError(str(exc))


def print_plan(steps, notes, out, heading):
    out.write("%s\n" % heading)
    for step in steps:
        out.write("  %-9s %s\n" % (step.state, step.title))
    for note in notes:
        out.write("\nnote: %s\n" % note)
    out.write("\n")


def confirm(args, out, interactive, input_fn):
    if args.yes:
        return True
    if not interactive:
        out.write("Not running interactively; re-run with --yes to apply, or --dry-run to preview.\n")
        return False
    return input_fn("Proceed? [y/N] ").strip().lower() in ("y", "yes")


def install(ctx, args, out, interactive=False, input_fn=input):
    h = load_helper(ctx)
    try:
        steps, notes = plan_install(ctx, h, args)
    except InstallError as exc:
        out.write("Cannot install: %s\n" % exc)
        return 1
    print_plan(steps, notes, out, "Plan:")
    pending = [s for s in steps if s.state != "unchanged"]
    if args.dry_run:
        out.write("Dry run: nothing was changed.\n")
        return 0
    if pending and not confirm(args, out, interactive, input_fn):
        out.write("Nothing was changed.\n")
        return 1
    if not pending:
        out.write("Nothing to do: everything is already in place.\n")
    else:
        try:
            run_steps(steps, out)
        except InstallError:
            out.write("\nInstall failed and was rolled back. Check the output above, then run "
                      "'doctor' to see the host's state.\n")
            return 1
        out.write("\nInstalled.\n")
    rep = doctor(ctx)
    render(rep, out, False)
    # Last line on purpose: the web UI asks the admin to compare this value.
    found = host_fingerprints(ctx)
    if found:
        out.write("\nServer fingerprint for the web UI: %s (ED25519)\n" % found[0])
    else:
        out.write("\nNo ED25519 server fingerprint found; see 'server identity' above.\n")
    return 1 if rep.failed else 0


# --- uninstalling ------------------------------------------------------------

def plan_uninstall(ctx, args):
    if ctx.euid != 0:
        raise InstallError("must run as root: sudo python3 %s"
                           % os.path.join(ctx.here, "wgmanager-host"))
    steps, notes = [], []
    unit = service_name(ctx) or "ssh"

    def present(path):
        return os.path.lexists(ctx.p(path))

    def remove_sshd():
        previous = read_bytes(ctx.p(SSHD_DROPIN_PATH))
        os.unlink(ctx.p(SSHD_DROPIN_PATH))
        code, _, err = ctx.run(["sshd", "-t"])
        if code != 0:
            restore(ctx, SSHD_DROPIN_PATH, previous, 0o644)
            raise InstallError("sshd would not accept its configuration without the drop-in "
                               "(%s); the drop-in was put back and nothing else was removed"
                               % ((err.strip().splitlines() or ["?"])[0]))
        code, _, err = ctx.run(["systemctl", "reload", unit])
        if code != 0:
            raise InstallError("could not reload sshd: %s" % ((err.strip().splitlines() or ["?"])[0]))
    steps.append(Step("sshd drop-in %s + reload %s" % (SSHD_DROPIN_PATH, unit),
                      "remove" if present(SSHD_DROPIN_PATH) else "unchanged", remove_sshd))

    def remove_file(path):
        return lambda: os.unlink(ctx.p(path))
    steps.append(Step("authorized key file %s" % AUTHORIZED_KEYS_PATH,
                      "remove" if present(AUTHORIZED_KEYS_PATH) else "unchanged",
                      remove_file(AUTHORIZED_KEYS_PATH)))
    steps.append(Step("sudo rule %s" % SUDOERS_PATH,
                      "remove" if present(SUDOERS_PATH) else "unchanged", remove_file(SUDOERS_PATH)))
    steps.append(Step("helper program %s" % HELPER_PATH,
                      "remove" if present(HELPER_PATH) else "unchanged", remove_file(HELPER_PATH)))

    try:
        pw = ctx.getpwnam(ACCOUNT)
    except KeyError:
        pw = None

    def remove_account():
        code, _, err = ctx.run(["userdel", ACCOUNT])
        if code != 0:
            raise InstallError("userdel failed: %s. If %s still has a session, end it "
                               "(sudo pkill -u %s) and run uninstall again"
                               % ((err.strip().splitlines() or ["?"])[0], ACCOUNT, ACCOUNT))
    if pw is None:
        steps.append(Step("service account %s" % ACCOUNT, "unchanged"))
    elif pw.pw_uid >= 1000 or pw.pw_dir != "/nonexistent":
        steps.append(Step("service account %s" % ACCOUNT, "unchanged"))
        notes.append("User %s looks like an ordinary account (uid %d, home %s), not the one this tool "
                     "creates, so it was left alone." % (ACCOUNT, pw.pw_uid, pw.pw_dir))
    else:
        steps.append(Step("service account %s" % ACCOUNT, "remove", remove_account))

    config_file = os.path.join(CONFIG_DIR, "config")

    def remove_config_dir():
        if args.purge and present(config_file):
            os.unlink(ctx.p(config_file))
        try:
            os.rmdir(ctx.p(CONFIG_DIR))
        except OSError:
            pass
    steps.append(Step("config directory %s (if empty%s)" % (CONFIG_DIR, "; settings file too" if args.purge else ""),
                      "remove" if present(CONFIG_DIR) else "unchanged", remove_config_dir))

    backup_dir = "/var/backups/wgmanager"
    backup_name_re = None
    try:
        h = load_helper(ctx)
        backup_name_re = h.BACKUP_FILE_RE
        settings = ctx.settings_loader(h) if ctx.settings_loader else \
            h.load_settings(ctx.p(h.DEFAULT_CONFIG_PATH), False)
        backup_dir = settings.backup_dir
    except Exception:
        pass

    def purge_backups():
        # Only files named like the helper's own backups are deleted, then the
        # directory if that leaves it empty. Never a recursive delete of a
        # configurable path.
        for name in os.listdir(backup_dir):
            if backup_name_re is not None and backup_name_re.fullmatch(name):
                os.unlink(os.path.join(backup_dir, name))
        try:
            os.rmdir(backup_dir)
        except OSError:
            pass
    if args.purge:
        steps.append(Step("backups in %s (copies of your WireGuard config; deleted for good)" % backup_dir,
                          "remove" if os.path.isdir(backup_dir) else "unchanged", purge_backups))
    elif os.path.isdir(backup_dir):
        notes.append("Backups in %s were kept (use --purge to delete them)." % backup_dir)
    return steps, notes


def uninstall(ctx, args, out, interactive=False, input_fn=input):
    try:
        steps, notes = plan_uninstall(ctx, args)
    except InstallError as exc:
        out.write("Cannot uninstall: %s\n" % exc)
        return 1
    print_plan(steps, notes, out, "Plan:")
    pending = [s for s in steps if s.state != "unchanged"]
    if not pending:
        out.write("Nothing to remove: wgmanager's host side is not installed.\n")
        return 0
    if args.dry_run:
        out.write("Dry run: nothing was changed.\n")
        return 0
    if not confirm(args, out, interactive, input_fn):
        out.write("Nothing was changed.\n")
        return 1
    failed = False
    for step in pending:
        out.write("  ... %s\n" % step.title)
        try:
            step.apply()
        except (InstallError, OSError) as exc:
            failed = True
            out.write("  FAILED: %s\n" % exc)
            if step.title.startswith("sshd drop-in"):
                # While sshd still applies the drop-in, removing the rest could
                # leave a half-working login; stop so the user can fix it first.
                out.write("Stopping here; nothing after the sshd step was touched.\n")
                return 1
    out.write("\n%s\n" % ("Finished with problems; fix them and run uninstall again." if failed
                          else "Uninstalled."))
    return 1 if failed else 0


# --- commands ----------------------------------------------------------------

def doctor(ctx):
    ctx._sshd = None                     # always ask sshd afresh (install may just have changed it)
    rep = Report()
    if not check_privileges(ctx, rep):
        return rep
    check_platform(ctx, rep)
    try:
        h = load_helper(ctx)
    except (OSError, SyntaxError) as exc:
        rep.fail("cannot load wgmanager-helper next to this script (%s)" % exc)
        return rep
    check_pivpn(ctx, rep, h)
    try:
        ctx.getpwnam(ACCOUNT)
        account = True
    except KeyError:
        account = False
    if not account and not any(os.path.lexists(ctx.p(p)) for p in
                               (HELPER_PATH, SUDOERS_PATH, SSHD_DROPIN_PATH, CONFIG_DIR)):
        rep.section("wgmanager")
        rep.fail("the host side of wgmanager is not installed on this host", install_command(ctx))
        return rep
    check_helper_file(ctx, rep, h)
    check_account(ctx, rep)
    check_sudo(ctx, rep)
    check_sshd(ctx, rep)
    check_host_key(ctx, rep)
    check_authorized_keys(ctx, rep)
    check_end_to_end(ctx, rep)
    return rep


def build_parser():
    parser = argparse.ArgumentParser(
        prog="wgmanager-host",
        description="Install, check and remove the host side of wgmanager. Run as root.")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor", help="inspect the host and report problems with fixes (read-only)")

    inst = sub.add_parser(
        "install", help="install or update the helper, service account, sudo rule, sshd drop-in and key",
        description="Installs everything the web app needs on this host. Safe to run again: it "
                    "only changes what differs, and undoes its own changes if a step fails.")
    inst.add_argument("--pubkey-file", metavar="FILE",
                      help="the web app's PUBLIC key (a .pub file); without it, no key is installed yet")
    inst.add_argument("--pubkey", metavar="TEXT", help="the public key as text, instead of --pubkey-file")
    inst.add_argument("--allow-from", metavar="LIST",
                      help="comma-separated IPs/CIDRs the key may connect from (default: %s)"
                           % ",".join(DEFAULT_SOURCES))
    inst.add_argument("--replace-key", action="store_true",
                      help="replace a different key that is already installed")
    inst.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    inst.add_argument("--dry-run", action="store_true", help="show the plan and stop")

    rem = sub.add_parser(
        "uninstall", help="remove what install added (backups are kept unless --purge)")
    rem.add_argument("--purge", action="store_true",
                     help="also delete the helper's backups and settings file")
    rem.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    rem.add_argument("--dry-run", action="store_true", help="show the plan and stop")
    return parser


def main(argv=None, ctx=None, out=None, interactive=None, input_fn=input):
    args = build_parser().parse_args(argv)
    out = sys.stdout if out is None else out
    ctx = Host() if ctx is None else ctx
    if interactive is None:
        interactive = sys.stdin.isatty()
    color = hasattr(out, "isatty") and out.isatty() and "NO_COLOR" not in os.environ
    if args.command == "doctor":
        rep = doctor(ctx)
        render(rep, out, color)
        return 1 if rep.failed else 0
    if args.command == "install":
        return install(ctx, args, out, interactive, input_fn)
    if args.command == "uninstall":
        return uninstall(ctx, args, out, interactive, input_fn)
    return 2


if __name__ == "__main__":
    sys.exit(main())
