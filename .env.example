# Copy to .env and adjust. Every setting is optional.

# Web UI: published on this port (and address) of the host.
WEB_PORT=7501
# 0.0.0.0 = all IPv4 addresses. Set your server's LAN address to publish only there.
WEB_BIND=0.0.0.0

# How the app reaches sshd on the WireGuard server. The default host is the
# gateway of the app's own Docker network, which is the host itself.
SSH_HOST=172.29.88.1
SSH_PORT=22
SSH_USER=wgweb

# 1 only if an HTTPS reverse proxy sits in front (enables Secure cookies and
# trusts its X-Forwarded-* headers).
TRUST_PROXY=0

# Image tag to run (compose.yaml).
WGM_VERSION=latest
