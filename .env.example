# Copy to .env and adjust. Every setting is optional: one that is missing, empty or
# commented out uses its default, named in its comment.

# Web UI: published on this port (and address) of the host.
WEB_PORT=7501
# 0.0.0.0 = all IPv4 addresses. Set your server's LAN address to publish only there.
WEB_BIND=0.0.0.0

# How the app reaches sshd on the WireGuard server. The default host is the
# gateway of the app's own Docker network, which is the host itself.
SSH_HOST=172.29.88.1
SSH_PORT=22
SSH_USER=wgweb

# 1 only if an HTTPS reverse proxy sits in front (enables Secure cookies and
# trusts its X-Forwarded-* headers). Default: 0.
TRUST_PROXY=0

# Update check. Default: 0 (off), so the app makes no outbound connections except
# SSH to your server (and ntfy, if you set that up below). 1 (or true) = once at start and every 12 hours, the app asks
# GitHub for the latest release and shows a notice on the Host page if a newer one
# exists. It sends nothing but this app's version number.
# UPDATE_CHECK=1

# ---------------------------------------------------------------------------
# Notifications (ntfy). Default: off, so the app sends nothing anywhere.
#
# WG Manager can send short notifications to a ntfy server (https://ntfy.sh,
# self-hosted or public). The messages are generic: they never contain client
# names, keys or addresses. Open WG Manager to see the details.
#
# To use it: on your ntfy server, create a user that may only publish to your
# topic and an access token for it; uncomment the lines you need below; run
# "docker compose up -d"; then check it with:
#   docker exec wgmanager wgmanager ntfy-test
# ---------------------------------------------------------------------------

# Turn notifications on: true or false (1 or 0 also work). Default: false.
# NTFY_ENABLE=true

# Address of your ntfy server: scheme, host and, if it is not the standard port,
# the port. A path is fine if ntfy sits under one. No user name or password in the
# address. https:// is encrypted and its certificate is checked. http:// is allowed
# (for example a ntfy on your own network), but then the messages and the token
# travel unencrypted, and a warning is logged at start.
# Required when NTFY_ENABLE=true. Examples: https://ntfy.example.com  http://192.168.1.10:2586
# NTFY_URL=https://ntfy.example.com

# The topic to send to: letters, digits, "_" and "-", up to 64 characters.
# Required when NTFY_ENABLE=true. On a public server anyone who knows the name
# can read the messages, so choose one that is hard to guess.
# NTFY_TOPIC=wgmanager

# How WG Manager signs in to ntfy: a token (recommended) ...
# NTFY_TOKEN=tk_replace_with_your_token
# ... or a user name and a password (set both; do not combine with a token).
# Leave all three out if your topic needs no sign-in.
# NTFY_USER=wgmanager
# NTFY_PASSWORD=replace_with_the_password

# Which notifications to send. Each is true or false. Default: true for both.
# Errors: a change that failed or may be incomplete, or the VPN server can't be
# reached or is set up wrongly (the cases that show a warning in the web UI).
# WG Manager also checks the server about once a minute, with the same read-only
# requests the web UI makes. A problem is announced once, after two checks in a
# row (a changed server identity at once), and again when it is fixed. Change notices: at most 5 an hour.
# NTFY_ON_ERRORS=true
# Updates: a newer WG Manager release exists (needs UPDATE_CHECK=1 above), or the
# helper on your server is older than the one this image ships. Each is told
# once per release.
# NTFY_ON_UPDATES=true

# Image tag to run (compose.yaml): latest = newest release (vX.Y.Z tag),
# edge = newest commit on master, or a specific version such as 0.2.0.
WGM_VERSION=latest
